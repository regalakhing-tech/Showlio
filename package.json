{
  "name": "showlio",
  "version": "0.1.0",
  "private": true,
  "description": "Showlio PHP and Tailwind project foundation",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <26"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "watch:css": "tailwindcss -i src/styles/app.css -o public/assets/css/app.css --watch",
    "watch:workspace": "tailwindcss -i src/styles/workspace.css -o public/assets/css/workspace.css --watch",
    "watch:auth": "tailwindcss -i src/styles/auth.css -o public/assets/css/auth.css --watch",
    "watch:portfolio": "tailwindcss -i src/styles/portfolio.css -o public/assets/css/portfolio.css --watch",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "deploy:production": "node scripts/deploy.mjs",
    "vercel:env": "node scripts/vercel-env.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@tailwindcss/cli": "4.3.3",
    "jsqr": "1.4.0",
    "tailwindcss": "4.3.3"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4"
  }
}
