{
  "name": "showlio",
  "version": "0.1.0",
  "private": true,
  "description": "Showlio PHP and Tailwind project foundation",
  "type": "module",
  "engines": { "node": ">=24.0.0 <26" },
  "scripts": {
    "dev": "php -S 127.0.0.1:8000 -t public scripts/router.php",
    "build": "tailwindcss -i src/styles/app.css -o public/assets/css/app.css --minify",
    "watch:css": "tailwindcss -i src/styles/app.css -o public/assets/css/app.css --watch",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "deploy:production": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
