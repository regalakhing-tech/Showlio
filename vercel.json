{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "src/**"
    }
  },
  "rewrites": [
    { "source": "/portfolio/", "destination": "/portfolio/index.html" },
    { "source": "/portfolio/view/", "destination": "/portfolio/view/index.html" },
    { "source": "/app/", "destination": "/app/index.html" },
    { "source": "/auth/", "destination": "/auth/index.html" },
    { "source": "/copy/", "destination": "/copy/index.html" },
    { "source": "/api", "destination": "/api/index.php" },
    { "source": "/api/:path*", "destination": "/api/index.php" }
  ],
  "redirects": [
    { "source": "/portfolio", "destination": "/portfolio/", "permanent": true },
    { "source": "/portfolio/view", "destination": "/portfolio/view/", "permanent": true },
    { "source": "/app", "destination": "/app/", "permanent": true },
    { "source": "/auth", "destination": "/auth/", "permanent": true },
    { "source": "/copy", "destination": "/copy/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/assets/(icons|workspace-icons).svg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ],
  "git": { "deploymentEnabled": true }
}
