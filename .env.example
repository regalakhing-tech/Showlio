# Template only. Copy to .env for local development (git and Vercel ignore it),
# and set the same names in Vercel Project Settings > Environment Variables.
APP_ENV=local
APP_URL=http://127.0.0.1:8000

# Supabase Dashboard > Project Settings > API Keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative if the existing project still uses an anon key.
SUPABASE_ANON_KEY=
# Server-only secret key (sb_secret_...). Used for rate limits and account/code creation;
# without it the /api/auth routes answer 503. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# Code emails (sign-up, resend, password reset) are sent by PHP with PHPMailer over SMTP.
# For Gmail: smtp.gmail.com, port 587, tls, and a Google App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Showlio
# Where links and the logo in emails point.
SITE_URL=https://showlio-seven.vercel.app

# Future AI integration; server-only.
GEMINI_API_KEY=

# Vercel deployment credentials belong in GitHub Actions secrets, not this file.
