# Template only. The starter health endpoint needs no external credentials.
# Configure process environment variables locally or use Vercel Project Settings.
APP_ENV=local
APP_URL=http://127.0.0.1:8000

# Future Supabase integration (not connected by this starter).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative if the existing project still uses an anon key.
SUPABASE_ANON_KEY=

# Future AI integration; server-only.
GEMINI_API_KEY=

# Elevated Supabase keys are deliberately omitted: ordinary CRUD should use RLS.
# Vercel deployment credentials belong in GitHub Actions secrets, not this file.
